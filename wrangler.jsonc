{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osrsflipit",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osrshub-accounts",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
